# ==========================================================
# PRODUCTION CONFIG (REQUIRED CHANGES)
# ==========================================================
# YOU MUST UPDATE THESE VALUES IN PRODUCTION
# DO NOT INCLUDE QUOTES ("") IN VALUES
# DO NOT LEAVE TRAILING SPACES

# Base ingress URL (no trailing slash)
INGRESS_URL=http://...

# Service endpoints (derived from ingress)
NGO_SERVICE_URL=${INGRESS_URL}/ngos
DONATION_SERVICE_URL=${INGRESS_URL}/donations
VOLUNTEER_SERVICE_URL=${INGRESS_URL}/volunteers

# AWS (session-token creds from AWS Academy Learner Lab — expire ~4h, must be refreshed per session)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_SESSION_TOKEN=REPLACE_ME
